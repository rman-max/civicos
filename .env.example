# Application identity
CIVICOS_ENVIRONMENT=development
CIVICOS_LOG_LEVEL=INFO
CIVICOS_ALLOWED_HOSTS=["localhost","127.0.0.1"]

# API authentication. Development mode preserves the local header-based test workflow.
# Production uses OIDC by default. `founder_secret` is a temporary, one-founder
# production mode; the secret remains server-side and is never a NEXT_PUBLIC_ value.
CIVICOS_AUTH_MODE=development
CIVICOS_AUTH_ISSUER=
CIVICOS_AUTH_AUDIENCE=
CIVICOS_AUTH_JWKS_URL=
CIVICOS_AUTH_ORGANIZATION_CLAIM=organization_id
# Required only when CIVICOS_AUTH_MODE=founder_secret. Use a unique 32+ character secret.
CIVICOS_FOUNDER_AUTH_SECRET=
CIVICOS_FOUNDER_EXTERNAL_SUBJECT=civicos-founder
CIVICOS_FOUNDER_EMAIL=founder@civicos.local
CIVICOS_FOUNDER_DISPLAY_NAME=CivicOS Founder
CIVICOS_FOUNDER_ORGANIZATION_SLUG=st-joseph-county-indiana
CIVICOS_FOUNDER_ORGANIZATION_NAME=St. Joseph County, Indiana
CIVICOS_FOUNDER_TOKEN_TTL_SECONDS=3600
CIVICOS_API_MAX_REQUEST_BYTES=1000000
CIVICOS_API_RATE_LIMIT_PER_MINUTE=120
# Keep this confidential and expose /metrics only to your monitoring network.
CIVICOS_METRICS_TOKEN=change-me-before-deployment

# Public endpoints. NEXT_PUBLIC_* values are intentionally non-secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Off by default for local development. Public beta analytics is first-party and anonymous.
NEXT_PUBLIC_BETA_ANALYTICS_ENABLED=false
CIVICOS_API_CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL. Use a unique, non-default password outside local development.
POSTGRES_DB=civicos
POSTGRES_USER=civicos
POSTGRES_PASSWORD=change-me-before-deployment
DATABASE_URL=postgresql+psycopg://civicos:change-me-before-deployment@postgres:5432/civicos

# Qdrant stores document vectors for semantic search.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=civicos_documents

# AI providers are intentionally unset until model policy is approved.
MODEL_PROVIDER=local
MODEL_BASE_URL=
MODEL_NAME=

# OpenAI-compatible answer endpoint (Ollama/vLLM or another approved local provider).
# The assistant remains unavailable until both LLM_BASE_URL and LLM_MODEL are configured.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
CIVICOS_ASSISTANT_RETRIEVAL_LIMIT=8
CIVICOS_ASSISTANT_MAX_CLAIMS=5
CIVICOS_ASSISTANT_MIN_CITATIONS_PER_CLAIM=1
CIVICOS_ASSISTANT_TARGET_INDEPENDENT_SOURCES=2
CIVICOS_ASSISTANT_TEMPERATURE=0
CIVICOS_ASSISTANT_HIGH_CONFIDENCE_THRESHOLD=0.85
CIVICOS_ASSISTANT_MEDIUM_CONFIDENCE_THRESHOLD=0.6

# OpenAI-compatible embedding endpoint (Ollama/vLLM or another approved local provider).
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
CIVICOS_EMBEDDING_MAX_CHARACTERS=30000
CIVICOS_SEARCH_MAX_LIMIT=50

# Object storage for raw source artifacts. Any S3-compatible service is supported.
# Leave S3_ENDPOINT_URL empty only when using AWS S3.
S3_ENDPOINT_URL=
S3_BUCKET=civicos-raw
S3_ACCESS_KEY=change-me-before-deployment
S3_SECRET_KEY=change-me-before-deployment

# Autonomous discovery worker (enabled with the `discovery` Compose profile).
CIVICOS_DISCOVERY_POLL_SECONDS=5
CIVICOS_DISCOVERY_USER_AGENT=CivicOS-Discovery/0.1

# Daily briefing generation runs inside the autonomous worker. Use an IANA timezone.
CIVICOS_BRIEFING_TIMEZONE=UTC
CIVICOS_BRIEFING_NEAR_TERM_DAYS=7
CIVICOS_BRIEFING_LOOKAHEAD_DAYS=14
CIVICOS_BRIEFING_SECTION_LIMIT=10

# Private Founder Intelligence briefing. Scores are deterministic and evidence-bound.
CIVICOS_FOUNDER_BRIEF_MINIMUM_SCORE=70
CIVICOS_FOUNDER_BRIEF_SECTION_LIMIT=8
